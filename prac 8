<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Registration</title>
  <style>
    body { font-family: Arial, sans-serif; background: lightcyan; display: flex; justify-content: center; padding: 40px 15px; }
    form { background: white; width: 340px; padding: 25px; border-radius: 12px; box-shadow: 0 4px 12px gray; }
    h2 { text-align: center; color: teal; margin-top: 0; }
    label { font-weight: bold; font-size: 14px; }
    input:not([type=checkbox]), select { width: 100%; padding: 10px; margin: 5px 0 2px; border: 2px solid lightgray; border-radius: 6px; box-sizing: border-box; }
    .valid { border-color: green !important; }
    .invalid { border-color: red !important; }
    .error { color: red; font-size: 12px; display: block; min-height: 16px; margin-bottom: 8px; }
    .check { font-weight: normal; }
    button { width: 100%; padding: 11px; background: teal; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 15px; }
    button:hover { background: darkcyan; }
    #success { color: green; text-align: center; font-weight: bold; margin: 10px 0 0; }
  </style>
</head>
<body>
  <form id="regForm" novalidate>
    <h2>Student Registration</h2>
    <label>Full Name</label>
    <input type="text" id="name" placeholder="Enter full name">
    <span class="error" id="nameErr"></span>
    <label>Email Address</label>
    <input type="text" id="email" placeholder="Enter email">
    <span class="error" id="emailErr"></span>
    <label>Password</label>
    <input type="password" id="password" placeholder="Minimum 8 characters">
    <span class="error" id="passwordErr"></span>
    <label>Mobile Number</label>
    <input type="text" id="mobile" placeholder="10-digit mobile number">
    <span class="error" id="mobileErr"></span>
    <label>Course</label>
    <select id="course">
      <option value="">-- Select Course --</option>
      <option>CSE</option><option>CSE (Data Science)</option><option>IT</option><option>Electronics</option>
    </select>
    <span class="error" id="courseErr"></span>
    <label class="check"><input type="checkbox" id="agree"> I agree to the terms and conditions</label>
    <span class="error" id="agreeErr"></span>
    <button type="submit">Register</button>
    <p id="success"></p>
  </form>
  <script>
    const form = document.getElementById("regForm");
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const mobileRegex = /^[0-9]{10}$/;
    function show(id, message) {
      document.getElementById(id + "Err").textContent = message;
      document.getElementById(id).className = message ? "invalid" : "valid";
      return message === "";
    }
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      const name = document.getElementById("name").value.trim();
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const mobile = document.getElementById("mobile").value.trim();
      const course = document.getElementById("course").value;
      const agree = document.getElementById("agree").checked;
      const results = [
        show("name", name === "" ? "Full name is required." : ""),
        show("email", email === "" ? "Email is required." : !emailRegex.test(email) ? "Enter a valid email address." : ""),
        show("password", password.length < 8 ? "Password must be at least 8 characters." : ""),
        show("mobile", !mobileRegex.test(mobile) ? "Enter a valid 10-digit mobile number." : ""),
        show("course", course === "" ? "Please select a course." : ""),
        show("agree", agree ? "" : "You must accept the terms.")
      ];
      const success = document.getElementById("success");
      if (results.every(Boolean)) {
        success.textContent = "Registration successful!";
        form.reset();
        form.querySelectorAll(".valid").forEach(el => el.className = "");
      } else {
        success.textContent = "";
      }
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expense Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-100 font-sans">
  <header class="bg-emerald-600 text-white text-center py-6 shadow">
    <h1 class="text-2xl md:text-3xl font-bold">Student Expense Tracker</h1>
    <p class="text-emerald-100 text-sm">Track where your money goes</p>
  </header>
  <main class="max-w-5xl mx-auto p-6 flex flex-col md:flex-row gap-6">
    <section class="md:w-1/3 h-fit bg-white rounded-xl shadow p-5">
      <h2 class="text-lg font-semibold text-slate-700 mb-3">Add Expense</h2>
      <input id="title" type="text" placeholder="Title" class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-emerald-400">
      <input id="amount" type="number" placeholder="Amount (₹)" class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-emerald-400">
      <select id="category" class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-emerald-400">
        <option>Food</option><option>Travel</option><option>Books</option><option>Other</option>
      </select>
      <button id="addBtn" class="w-full bg-emerald-600 text-white py-2 rounded-lg hover:bg-emerald-500 active:scale-95 transition">Add Expense</button>
      <p id="msg" class="text-red-500 text-sm mt-2"></p>
    </section>
    <section class="md:w-2/3">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white rounded-xl shadow p-5 mb-4">
        <div><p class="text-sm text-slate-500">Total Spent</p><p id="total" class="text-3xl font-bold text-emerald-600">₹0</p></div>
        <select id="filter" class="border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-400">
          <option>All</option><option>Food</option><option>Travel</option><option>Books</option><option>Other</option>
        </select>
      </div>
      <ul id="list" class="space-y-2"></ul>
    </section>
  </main>
  <script>
    let expenses = JSON.parse(localStorage.getItem("expenses")) || [];
    const badge = { Food: "bg-orange-100 text-orange-700", Travel: "bg-sky-100 text-sky-700", Books: "bg-purple-100 text-purple-700", Other: "bg-slate-200 text-slate-700" };
    function render() {
      const filter = document.getElementById("filter").value;
      const shown = expenses.filter(e => filter === "All" || e.category === filter);
      document.getElementById("list").innerHTML = shown.length === 0
        ? '<li class="text-center text-slate-400 py-6">No expenses yet</li>'
        : shown.map(e => `
          <li class="flex items-center justify-between bg-white rounded-lg shadow-sm px-4 py-3">
            <div>
              <p class="font-semibold text-slate-800">${e.title.replace(/</g, "&lt;")}</p>
              <span class="text-xs px-2 py-1 rounded-full ${badge[e.category]}">${e.category}</span>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-bold text-slate-700">₹${e.amount}</span>
              <button data-id="${e.id}" class="delete text-red-500 hover:text-red-700 font-bold">✕</button>
            </div>
          </li>`).join("");
      document.getElementById("total").textContent = "₹" + shown.reduce((sum, e) => sum + e.amount, 0);
      localStorage.setItem("expenses", JSON.stringify(expenses));
    }
    document.getElementById("addBtn").addEventListener("click", function () {
      const title = document.getElementById("title").value.trim();
      const amount = parseFloat(document.getElementById("amount").value);
      const category = document.getElementById("category").value;
      const msg = document.getElementById("msg");
      if (title === "" || isNaN(amount) || amount <= 0) {
        msg.textContent = "Enter a valid title and amount.";
        return;
      }
      msg.textContent = "";
      expenses.push({ id: Date.now(), title, amount, category });
      document.getElementById("title").value = "";
      document.getElementById("amount").value = "";
      render();
    });
    document.getElementById("list").addEventListener("click", function (e) {
      if (e.target.classList.contains("delete")) {
        expenses = expenses.filter(x => x.id !== Number(e.target.dataset.id));
        render();
      }
    });
    document.getElementById("filter").addEventListener("change", render);
    render();
  </script>
</body>
</html>
